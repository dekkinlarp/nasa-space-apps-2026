{
  "name": "@marsmap/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data pipeline: downloads and derives everything the Martian Map app needs into data/<areaId>/",
  "scripts": {
    "all": "vite-node --script src/all.ts",
    "elevation": "vite-node --script src/elevation.ts",
    "derive": "vite-node --script src/derive.ts",
    "minerals": "vite-node --script src/minerals.ts",
    "imagery": "vite-node --script src/imagery.ts",
    "rover": "vite-node --script src/rover.ts",
    "photos": "vite-node --script src/photos.ts",
    "conditions": "vite-node --script src/conditions.ts",
    "manifest": "vite-node --script src/manifest.ts",
    "preview": "vite-node --script src/preview.ts",
    "verify": "vite-node --script src/verify.ts",
    "import-layer": "vite-node --script src/import-layer.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prefetch": "vite-node --script src/prefetch.ts"
  },
  "dependencies": {
    "@marsmap/core": "workspace:*",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0"
  }
}
