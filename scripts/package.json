    "rover": "tsx src/rover.ts",
    "photos": "tsx src/photos.ts",
    "conditions": "tsx src/conditions.ts",
    "manifest": "tsx src/manifest.ts",
    "preview": "tsx src/preview.ts",
    "verify": "tsx src/verify.ts",
